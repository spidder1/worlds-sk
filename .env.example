# ---------------------------------------------------------------------------
# Worlds.sk — environment variables
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Neon PostgreSQL. Required by the storefront, the importer and every script.
# There is no fallback: a missing value fails loudly instead of silently
# connecting to somebody else's database.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Public origin the storefront presents to search engines. Anything other than
# the production origin is served with a noindex robots policy, so staging and
# preview deployments cannot be indexed under worlds.sk canonicals.
NEXT_PUBLIC_SITE_URL=https://worlds.sk

# eD system SOAP web service (supplier catalogue, stock, prices, dropshipping).
ED_LOGIN=
ED_PASSWORD=
ED_ENDPOINT_URL=https://private-ws-sk.elinkx.biz/service.asmx

# Import tuning.
# ED_CATALOG_SCOPE: it-only (default) keeps the catalogue to IT goods.
# ED_BRAND_SCOPE:   comma-separated brand allowlist. Empty means every brand.
ED_CATALOG_SCOPE=it-only
ED_BRAND_SCOPE=ASUS,Lenovo
IMPORT_BATCH_SIZE=200

# ---------------------------------------------------------------------------
# Optional — debugging aids for running the importer against a local catalogue
# dump rather than downloading from eD. Leave unset in any deployment.
# ---------------------------------------------------------------------------
# IMPORT_MODE=full
# ED_SOURCE_FILE=./downloads/productCatalogue_main.zip
# ALLOW_CACHED_FULL=true

# ---------------------------------------------------------------------------
# Set by Vercel automatically — never define these yourself:
#   VERCEL_URL, NEXT_PUBLIC_VERCEL_URL
#
# No longer read by anything. If they are still set on a deployment or in CI,
# delete them:
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_URL, SUPABASE_SECRET_KEY
#   SUPABASE_IMPORT_TRANSPORT, IMPORT_TRANSPORT
# Neon is now the only database the storefront and the importer talk to.
# ---------------------------------------------------------------------------
