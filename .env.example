# eD system integration (server/import jobs only).
ED_ENDPOINT_URL=https://private-ws-sk.elinkx.biz/service.asmx
ED_LOGIN=replace_me
ED_PASSWORD=replace_me

# Optional local/offline source. A full import from cache must be explicitly enabled.
ED_SOURCE_FILE=C:\path\to\catalog-or-stock.xml
ALLOW_CACHED_FULL=false
IMPORT_BATCH_SIZE=50
ED_CATALOG_SCOPE=it-only

# Development sample mode. Keep this enabled until the sample catalogue is verified.
ED_SAMPLE_ONLY=true
ED_SAMPLE_BRANDS=ASUS,Lenovo
ED_MIN_COST_EUR=0

# Direct PostgreSQL jobs only.
DATABASE_URL=postgresql://user:password@host:5432/database
