{
  "name": "@worlds/importer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "worlds-importer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "import:sample": "node dist/cli.js --sample",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@worlds/ed-client": "workspace:*",
    "@worlds/types": "workspace:*",
    "fast-xml-parser": "^4.5.3",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
