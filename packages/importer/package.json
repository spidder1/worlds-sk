{
  "name": "@worlds/importer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "import:enterprise": "node dist/enterprise-pipeline.js",
    "process:deltas": "node dist/process-deltas-to-master.js",
    "import:staging": "node dist/import-staging.js",
    "import:all": "node dist/import-all-products.js",
    "import:notebooks": "node dist/import-notebooks.js",
    "sync:catalog": "node dist/catalog-sync.js --mode=full",
    "sync:stock-price": "node dist/catalog-sync.js --mode=stock-price",
    "import:sample": "node dist/cli.js --sample",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@worlds/ed-client": "workspace:*",
    "@worlds/types": "workspace:*",
    "adm-zip": "0.6.0",
    "fast-xml-parser": "5.11.1",
    "pg": "^8.13.3",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3"
  }
}
