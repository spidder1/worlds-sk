{
  "name": "worlds-commerce-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Worlds.sk Commerce Platform & AI Ingestion Pipeline",
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "dev:storefront": "pnpm --filter storefront dev",
    "dev:importer": "pnpm --filter @worlds/importer dev",
    "import:sample": "pnpm --filter @worlds/importer run import:sample"
  },
  "devDependencies": {
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3"
  }
}
