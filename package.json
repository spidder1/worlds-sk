{
  "name": "worlds-commerce-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Worlds.sk Commerce Platform & AI Ingestion Pipeline",
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "build": "pnpm --filter @worlds/types run build && pnpm --filter @worlds/ed-client run build && pnpm --filter @worlds/importer run build && pnpm --filter storefront run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "dev:storefront": "pnpm --filter storefront dev",
    "dev:importer": "pnpm --filter @worlds/importer dev",
    "import:sample-neon": "pnpm --filter @worlds/importer run import:sample-neon",
    "import:neon": "pnpm --filter @worlds/importer run import:neon",
    "import:neon:stock": "pnpm --filter @worlds/importer run import:neon:stock",
    "import:neon:dry-run": "pnpm --filter @worlds/importer run import:neon:dry-run",
    "db:migrate": "node scripts/migrate-neon.mjs",
    "report:classification": "node scripts/report-classification.mjs",
    "import:sample": "pnpm --filter @worlds/importer run import:sample"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "adm-zip": "0.6.0",
    "fast-xml-parser": "5.11.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/pg": "^8.11.11",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.26"
    }
  }
}
