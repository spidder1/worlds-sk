{
  "name": "worlds-commerce-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Worlds.sk Commerce Platform & AI Ingestion Pipeline",
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "build": "pnpm --filter @worlds/types run build && pnpm --filter @worlds/ed-client run build && pnpm --filter @worlds/importer run build && pnpm --filter storefront run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "dev:storefront": "pnpm --filter storefront dev",
    "dev:importer": "pnpm --filter @worlds/importer dev",
    "import:enterprise": "pnpm --filter @worlds/importer run import:enterprise",
    "process:deltas": "pnpm --filter @worlds/importer run process:deltas",
    "import:staging": "pnpm --filter @worlds/importer run import:staging",
    "import:all": "pnpm --filter @worlds/importer run import:all",
    "import:notebooks": "pnpm --filter @worlds/importer run import:notebooks",
    "import:sample": "pnpm --filter @worlds/importer run import:sample"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "fast-xml-parser": "^4.5.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
